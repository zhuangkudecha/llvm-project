        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="driver" target="stream"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="stream" target="launch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E11D48;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="sass" target="driver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1435" y="470"/><mxPoint x="610" y="470"/><mxPoint x="610" y="535"/></Array></mxGeometry></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="launch" target="block"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="700"/><mxPoint x="205" y="700"/></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="block" target="sm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="sm" target="warp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="warp" target="units"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="units" target="memory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0EA5E9;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0EA5E9;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0EA5E9;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="title" value="GPU 抽象模型：CUDA 算子与 AI 编译器生成的机器码怎样运行" style="text;html=1;fontFamily=JetBrains Mono;fontSize=24;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1350" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="一张图串起编译期、Host/Driver 运行期与 GPU 设备执行期；以 fused matmul + bias + ReLU 为例" style="text;html=1;fontFamily=JetBrains Mono;fontSize=12;fontColor=#475569;align=left;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1200" height="26" as="geometry"/></mxCell>
        <mxCell id="bg1" value="" style="rounded=1;html=1;fillColor=#F5F3FF;fillOpacity=18;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="1540" height="350" as="geometry"/></mxCell>
        <mxCell id="bg2" value="" style="rounded=1;html=1;fillColor=#ECFDF5;fillOpacity=18;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="1540" height="170" as="geometry"/></mxCell>
        <mxCell id="bg3" value="" style="rounded=1;html=1;fillColor=#F1F5F9;fillOpacity=18;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="1540" height="200" as="geometry"/></mxCell>
        <mxCell id="bg4" value="" style="rounded=1;html=1;fillColor=#EFF6FF;fillOpacity=18;strokeColor=#0EA5E9;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="955" width="1540" height="135" as="geometry"/></mxCell>
        <mxCell id="h1" value="① 编译期：高层语义 → 并行 kernel → 目标机器码" style="text;html=1;fontFamily=JetBrains Mono;fontSize=14;fontStyle=1;fontColor=#5B21B6;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="123" width="600" height="24" as="geometry"/></mxCell>
        <mxCell id="h2" value="② 运行期（CPU / CUDA Driver）：装载代码、准备参数、异步提交" style="text;html=1;fontFamily=JetBrains Mono;fontSize=14;fontStyle=1;fontColor=#047857;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="513" width="720" height="24" as="geometry"/></mxCell>
        <mxCell id="h3" value="③ GPU 执行期：以 block 调度、以 warp 发射 SASS 指令" style="text;html=1;fontFamily=JetBrains Mono;fontSize=14;fontStyle=1;fontColor=#334155;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="733" width="650" height="24" as="geometry"/></mxCell>
        <mxCell id="h4" value="④ tiled matmul 中一个 C tile 的概念循环" style="text;html=1;fontFamily=JetBrains Mono;fontSize=14;fontStyle=1;fontColor=#075985;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="968" width="520" height="24" as="geometry"/></mxCell>

        <mxCell id="op" value="AI / 框架算子&#xa;Y = ReLU(A×B + bias)&#xa;&#xa;算子 ≠ 一条 GPU 指令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="190" height="125" as="geometry"/></mxCell>
        <mxCell id="opt" value="图 / 张量优化&#xa;shape · 常量折叠&#xa;算子融合 · 内存规划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="275" y="185" width="180" height="115" as="geometry"/></mxCell>
        <mxCell id="mapping" value="并行映射 / 调度&#xa;tile · layout · vectorize&#xa;grid / block / thread&#xa;register / shared-memory 规划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="175" width="210" height="135" as="geometry"/></mxCell>
        <mxCell id="ir" value="GPU 低层 IR&#xa;MLIR GPU / NVGPU&#xa;LLVM IR + NVVM intrinsics&#xa;仍是编译器 IR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="735" y="180" width="205" height="125" as="geometry"/></mxCell>
        <mxCell id="ptx" value="PTX：虚拟 GPU ISA&#xa;可读汇编 / 可携带进制&#xa;不是 SM 最终机器码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="975" y="185" width="205" height="115" as="geometry"/></mxCell>
        <mxCell id="sass" value="cubin / fatbin 中的 SASS&#xa;目标 GPU 架构机器码&#xa;load · mma · add · branch ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;fontColor=#9F1239;" vertex="1" parent="1"><mxGeometry x="1220" y="180" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="library" value="常见旁路：调用 cuBLAS / cuDNN&#xa;库内部选择预编译或 JIT kernel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=1.5;dashed=1;fontFamily=JetBrains Mono;fontSize=11;fontColor=#581C87;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="host" value="Host / 框架 Runtime&#xa;显存分配 · 数据搬运&#xa;准备参数与 launch config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="75" y="555" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="driver" value="CUDA Runtime / Driver&#xa;装载 module · 选择 cubin&#xa;或把 PTX JIT 为当前 GPU 的 SASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="465" y="545" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="stream" value="CUDA Stream 命令队列&#xa;H2D → kernel → D2H&#xa;同一 stream 内有序；host 通常异步返回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="545" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="launch" value="Launch 实例&#xa;kernel + 参数&#xa;gridDim × blockDim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1325" y="555" width="205" height="90" as="geometry"/></mxCell>
        <mxCell id="block" value="Grid → Thread Blocks&#xa;block 动态分派给有资源的 SM&#xa;一个 SM 可同时驻留多个 block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="785" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="sm" value="SM Residency&#xa;受 registers / shared memory / warp slots 限制&#xa;block threads → 32-thread warps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="345" y="780" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="warp" value="Warp Scheduler&#xa;选择 ready warp；等待数据的 warp 暂停&#xa;发射下一条 SASS 指令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="780" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="units" value="执行流水线&#xa;FP / INT · Tensor Cores&#xa;LD-ST · SFU · Branch&#xa;active lanes SIMT 执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="955" y="780" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="memory" value="存储层级&#xa;Register（每线程）&#xa;Shared Memory / L1（SM / block）&#xa;L2（全 GPU）→ HBM / DRAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="780" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="s1" value="① Global → Shared&#xa;协作搬 A / B tile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#075985;" vertex="1" parent="1"><mxGeometry x="55" y="1005" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="s2" value="② barrier&#xa;等 tile 完整可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#075985;" vertex="1" parent="1"><mxGeometry x="400" y="1005" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="s3" value="③ MMA / FMA 累加&#xa;accumulator 留在 registers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#075985;" vertex="1" parent="1"><mxGeometry x="735" y="1005" width="280" height="65" as="geometry"/></mxCell>
        <mxCell id="s4" value="④ 沿 K 循环后写回 C&#xa;完成后 stream 执行下一命令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0EA5E9;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#075985;" vertex="1" parent="1"><mxGeometry x="1110" y="1005" width="370" height="65" as="geometry"/></mxCell>

        <mxCell id="l1" value="lowering" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="1"><mxGeometry x="707" y="230" width="25" height="24" as="geometry"/></mxCell>
        <mxCell id="l2" value="NVPTX" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="1"><mxGeometry x="944" y="230" width="26" height="24" as="geometry"/></mxCell>
        <mxCell id="l3" value="ptxas / Driver JIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDA4AF;spacing=3;fontFamily=JetBrains Mono;fontSize=9;fontColor=#BE123C;" vertex="1" parent="1"><mxGeometry x="1184" y="218" width="30" height="46" as="geometry"/></mxCell>
        <mxCell id="l4" value="module 装载 / JIT 产物" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#FDA4AF;spacing=3;fontFamily=JetBrains Mono;fontSize=9;fontColor=#BE123C;" vertex="1" parent="1"><mxGeometry x="780" y="458" width="145" height="24" as="geometry"/></mxCell>
        <mxCell id="l5" value="API" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="1"><mxGeometry x="370" y="585" width="42" height="24" as="geometry"/></mxCell>
        <mxCell id="l6" value="enqueue" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="1"><mxGeometry x="795" y="585" width="56" height="24" as="geometry"/></mxCell>
        <mxCell id="l7" value="动态分派 blocks" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="1"><mxGeometry x="705" y="688" width="105" height="24" as="geometry"/></mxCell>
        <mxCell id="l8" value="形成 warps" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="1"><mxGeometry x="618" y="825" width="29" height="30" as="geometry"/></mxCell>
        <mxCell id="l9" value="issue SASS" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="1"><mxGeometry x="923" y="825" width="29" height="30" as="geometry"/></mxCell>
        <mxCell id="note" value="关键结论：AI 编译器不会把 MatMul 变成“一条指令”。它先做融合、分块和线程映射，再生成许多目标指令；GPU 以 block 为调度单位、以 warp 为指令发射单位执行 SASS。具体 SM 单元数量随架构变化，CUDA thread 也不会长期绑定某个 CUDA core。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontStyle=1;fontColor=#78350F;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="55" y="910" width="1150" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
