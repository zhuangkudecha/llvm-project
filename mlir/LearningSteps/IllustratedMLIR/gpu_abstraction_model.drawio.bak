        <mxCell id="p2-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0EA5E9;strokeWidth=2;dashed=1;endArrow=block;" edge="1" parent="p2-1" source="p2-fast2" target="p2-fast3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0EA5E9;strokeWidth=2;dashed=1;endArrow=block;" edge="1" parent="p2-1" source="p2-fast3" target="p2-fast4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;strokeWidth=1.5;dashed=1;endArrow=block;" edge="1" parent="p2-1" source="p2-control" target="p2-sched"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="p2-title" value="GPU 物理执行模型：有哪些资源，为什么并行计算快" style="text;html=1;fontFamily=JetBrains Mono;fontSize=24;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="p2-1"><mxGeometry x="40" y="20" width="1250" height="42" as="geometry"/></mxCell>
        <mxCell id="p2-subtitle" value="GPU 是吞吐量处理器：复制大量执行资源，用成百上千个 resident warps 覆盖访存和流水线延迟" style="text;html=1;fontFamily=JetBrains Mono;fontSize=12;fontColor=#475569;align=left;" vertex="1" parent="p2-1"><mxGeometry x="42" y="62" width="1250" height="26" as="geometry"/></mxCell>
        <mxCell id="p2-bgchip" value="" style="rounded=1;html=1;fillColor=#ECFDF5;fillOpacity=18;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="p2-1"><mxGeometry x="30" y="110" width="730" height="570" as="geometry"/></mxCell>
        <mxCell id="p2-bgsm" value="" style="rounded=1;html=1;fillColor=#F1F5F9;fillOpacity=18;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="p2-1"><mxGeometry x="790" y="110" width="780" height="570" as="geometry"/></mxCell>
        <mxCell id="p2-bgfast" value="" style="rounded=1;html=1;fillColor=#EFF6FF;fillOpacity=18;strokeColor=#0EA5E9;strokeWidth=1.5;" vertex="1" parent="p2-1"><mxGeometry x="30" y="720" width="1540" height="260" as="geometry"/></mxCell>
        <mxCell id="p2-chiphead" value="① GPU 芯片全景：大量 SM + 共享缓存/显存系统" style="text;html=1;fontFamily=JetBrains Mono;fontSize=14;fontStyle=1;fontColor=#047857;align=left;" vertex="1" parent="p2-1"><mxGeometry x="50" y="125" width="600" height="25" as="geometry"/></mxCell>
        <mxCell id="p2-smhead" value="② 单个 SM 放大：调度、片上存储与多类执行流水线" style="text;html=1;fontFamily=JetBrains Mono;fontSize=14;fontStyle=1;fontColor=#334155;align=left;" vertex="1" parent="p2-1"><mxGeometry x="810" y="125" width="650" height="25" as="geometry"/></mxCell>
        <mxCell id="p2-fasthead" value="③ 为什么快：不是单个 thread 更快，而是单位时间完成更多工作" style="text;html=1;fontFamily=JetBrains Mono;fontSize=14;fontStyle=1;fontColor=#075985;align=left;" vertex="1" parent="p2-1"><mxGeometry x="50" y="735" width="760" height="25" as="geometry"/></mxCell>

        <mxCell id="p2-cmd" value="Host / CUDA Stream&#xa;kernel + 参数 + grid/block&#xa;命令通过 PCIe / NVLink 提交" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="p2-1"><mxGeometry x="55" y="180" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="p2-front" value="GPU Front End&#xa;Command Processor&#xa;Work Distributor&#xa;把可运行 blocks 分派到 SM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="p2-1"><mxGeometry x="300" y="175" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="p2-smarray" value="SM Array（很多个）&#xa;&#xa;SM 0　SM 1　SM 2　…　SM N-1&#xa;&#xa;每个 SM 独立驻留并执行多个 blocks / warps&#xa;同一 kernel 的大量 block 横向铺开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="p2-1"><mxGeometry x="545" y="165" width="190" height="240" as="geometry"/></mxCell>
        <mxCell id="p2-hbm" value="HBM / GDDR&#xa;Global Memory&#xa;容量大 · 延迟高&#xa;高总带宽" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#78350F;" vertex="1" parent="p2-1"><mxGeometry x="60" y="495" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="p2-l2" value="Memory Controllers + L2 Cache&#xa;所有 SM 共享&#xa;合并/coalesced 请求形成宽内存事务&#xa;原子操作与跨 SM 数据交换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#78350F;" vertex="1" parent="p2-1"><mxGeometry x="305" y="480" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="p2-copy" value="Copy Engines / DMA&#xa;计算与 H2D / D2H 搬运可在条件满足时重叠" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="p2-1"><mxGeometry x="620" y="500" width="115" height="105" as="geometry"/></mxCell>

        <mxCell id="p2-smzoom" value="Block Residency / 资源分配&#xa;registers + shared memory + warp slots + block slots&#xa;资源用量决定一个 SM 能同时容纳多少 blocks / warps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="p2-1"><mxGeometry x="820" y="170" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-control" value="取指与控制资源&#xa;Instruction Cache / Fetch&#xa;Constant Cache · Special Registers&#xa;Barrier / Synchronization Units" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontColor=#581C87;" vertex="1" parent="p2-1"><mxGeometry x="1190" y="170" width="340" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-warps" value="Resident Warp Pool&#xa;多个 block 的大量 warps&#xa;warp = 32 threads / lanes&#xa;保存 PC、active mask 与执行状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;" vertex="1" parent="p2-1"><mxGeometry x="820" y="330" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-sched" value="Warp Schedulers + Dispatch&#xa;每周期从 ready warps 中选取&#xa;遇到内存/依赖等待就发射别的 warp&#xa;切换无需保存完整 OS 线程上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;fontColor=#9F1239;" vertex="1" parent="p2-1"><mxGeometry x="1100" y="325" width="250" height="135" as="geometry"/></mxCell>
        <mxCell id="p2-reg" value="Register File&#xa;片上、容量大、按 thread 分配&#xa;保存 operands / accumulator&#xa;使用过多会降低 occupancy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontColor=#78350F;" vertex="1" parent="p2-1"><mxGeometry x="820" y="505" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-smem" value="Shared Memory / L1&#xa;SM 片上；block 内共享&#xa;缓存重复使用的 tile&#xa;低延迟但容量有限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontColor=#78350F;" vertex="1" parent="p2-1"><mxGeometry x="1060" y="505" width="210" height="125" as="geometry"/></mxCell>
        <mxCell id="p2-exec" value="执行流水线&#xa;FP32 / FP64 / INT ALU&#xa;Tensor Cores（矩阵 MMA）&#xa;Load/Store · SFU · Branch&#xa;&#xa;不同指令可进入不同流水线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="p2-1"><mxGeometry x="1310" y="485" width="225" height="155" as="geometry"/></mxCell>
        <mxCell id="p2-result" value="结果&#xa;写回 registers&#xa;或经 L1/L2 写入显存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;" vertex="1" parent="p2-1"><mxGeometry x="1390" y="335" width="145" height="100" as="geometry"/></mxCell>

        <mxCell id="p2-fast1" value="1. 大量并行宽度&#xa;许多 SM × 每 SM 多个 resident warps&#xa;同一数据并行 kernel 同时处理大量元素" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="p2-1"><mxGeometry x="55" y="790" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="p2-fast2" value="2. 用并发隐藏延迟&#xa;Warp A 等显存时发射 Warp B/C&#xa;不是让一次 DRAM 访问变快，而是不让流水线闲着" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="p2-1"><mxGeometry x="430" y="790" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="p2-fast3" value="3. 高带宽 + 数据复用&#xa;合并访存充分利用宽内存接口&#xa;tile 放入 shared memory / registers 后反复计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="p2-1"><mxGeometry x="815" y="790" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="p2-fast4" value="4. 专用且流水化的吞吐资源&#xa;SIMT 一条指令驱动多个 lanes&#xa;Tensor Core 用 MMA 指令完成矩阵块计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="p2-1"><mxGeometry x="1200" y="790" width="320" height="115" as="geometry"/></mxCell>

        <mxCell id="p2-l01" value="提交命令" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="p2-1"><mxGeometry x="262" y="217" width="32" height="28" as="geometry"/></mxCell>
        <mxCell id="p2-l02" value="分派 blocks" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="p2-1"><mxGeometry x="507" y="217" width="31" height="28" as="geometry"/></mxCell>
        <mxCell id="p2-l03" value="放大一个 SM" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="p2-1"><mxGeometry x="752" y="215" width="55" height="30" as="geometry"/></mxCell>
        <mxCell id="p2-l04" value="宽内存事务" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="p2-1"><mxGeometry x="257" y="540" width="42" height="28" as="geometry"/></mxCell>
        <mxCell id="p2-l08" value="选择 ready warp" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="p2-1"><mxGeometry x="1056" y="378" width="39" height="32" as="geometry"/></mxCell>
        <mxCell id="p2-l09" value="issue SASS" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#FDA4AF;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="p2-1"><mxGeometry x="1358" y="452" width="54" height="28" as="geometry"/></mxCell>
        <mxCell id="p2-compare" value="CPU vs GPU：CPU 用少量复杂核心、大缓存、乱序/预测追求单线程低延迟；GPU 把更多晶体管用于大量执行流水线和高带宽供数，追求可并行任务的总体吞吐。适合规则、数据并行、算术强度高的工作；串行依赖、强分支发散、小任务或频繁搬运未必更快。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#78350F;align=left;spacingLeft=12;spacingRight=12;" vertex="1" parent="p2-1"><mxGeometry x="55" y="1010" width="1000" height="75" as="geometry"/></mxCell>
        <mxCell id="p2-caution" value="性能门槛&#xa;• blocks 足够多，能铺满 SM&#xa;• register / shared-memory 用量不过量&#xa;• 访存合并且有复用&#xa;• 少分支发散、少同步&#xa;• 计算量足以摊薄 launch / 传输成本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontColor=#9F1239;align=left;spacingLeft=10;" vertex="1" parent="p2-1"><mxGeometry x="1100" y="995" width="420" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="gpu-memory" name="GPU存储层级与数据访问">
    <mxGraphModel dx="1600" dy="1120" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" shadow="0" background="#F8FAFC">
      <root>
        <mxCell id="m0"/><mxCell id="m1" parent="m0"/>
        <!-- edges first; captions use opaque standalone vertices -->
        <mxCell id="me01" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#059669;strokeWidth=2;endArrow=block;startArrow=block;" edge="1" parent="m1" source="m-exec" target="m-reg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me02" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;startArrow=block;" edge="1" parent="m1" source="m-reg" target="m-smem"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me03" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;startArrow=block;" edge="1" parent="m1" source="m-smem" target="m-l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me04" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;startArrow=block;" edge="1" parent="m1" source="m-l2" target="m-dram"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me05" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;startArrow=block;" edge="1" parent="m1" source="m-dram" target="m-host"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me06" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E11D48;strokeWidth=2;dashed=1;endArrow=block;" edge="1" parent="m1" source="m-reg" target="m-local"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="475"/><mxPoint x="470" y="575"/></Array></mxGeometry></mxCell>
        <mxCell id="me07" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E11D48;strokeWidth=2;dashed=1;endArrow=block;" edge="1" parent="m1" source="m-local" target="m-l2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="625"/><mxPoint x="840" y="475"/></Array></mxGeometry></mxCell>
        <mxCell id="me08" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0891B2;strokeWidth=1.5;dashed=1;endArrow=block;" edge="1" parent="m1" source="m-const" target="m-exec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="370"/><mxPoint x="170" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="me09" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0891B2;strokeWidth=1.5;dashed=1;endArrow=block;" edge="1" parent="m1" source="m-texture" target="m-exec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="535"/><mxPoint x="120" y="535"/><mxPoint x="120" y="300"/></Array></mxGeometry></mxCell>

        <mxCell id="mtitle" value="GPU 存储层级：作用域、物理路径与优化方法" style="text;html=1;fontFamily=JetBrains Mono;fontSize=24;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="m1"><mxGeometry x="40" y="20" width="1200" height="42" as="geometry"/></mxCell>
        <mxCell id="msub" value="越靠近执行单元：容量越小、延迟越低、带宽越高；越远：容量越大，但必须用并发与数据复用摊薄访问成本" style="text;html=1;fontFamily=JetBrains Mono;fontSize=12;fontColor=#475569;align=left;" vertex="1" parent="m1"><mxGeometry x="42" y="62" width="1350" height="26" as="geometry"/></mxCell>
        <mxCell id="mbg1" value="" style="rounded=1;html=1;fillColor=#ECFDF5;fillOpacity=18;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="m1"><mxGeometry x="30" y="110" width="1540" height="600" as="geometry"/></mxCell>
        <mxCell id="mbg2" value="" style="rounded=1;html=1;fillColor=#EFF6FF;fillOpacity=18;strokeColor=#0EA5E9;strokeWidth=1.5;" vertex="1" parent="m1"><mxGeometry x="30" y="750" width="1540" height="220" as="geometry"/></mxCell>
        <mxCell id="mh1" value="① 真实物理访问主路径" style="text;html=1;fontFamily=JetBrains Mono;fontSize=14;fontStyle=1;fontColor=#047857;align=left;" vertex="1" parent="m1"><mxGeometry x="50" y="125" width="360" height="25" as="geometry"/></mxCell>
        <mxCell id="mh2" value="② CUDA 地址空间：名称描述可见范围，不一定代表物理位置" style="text;html=1;fontFamily=JetBrains Mono;fontSize=13;fontStyle=1;fontColor=#9F1239;align=left;" vertex="1" parent="m1"><mxGeometry x="50" y="330" width="700" height="25" as="geometry"/></mxCell>
        <mxCell id="mh3" value="③ 优化顺序：先减少远端流量，再提高并发" style="text;html=1;fontFamily=JetBrains Mono;fontSize=14;fontStyle=1;fontColor=#075985;align=left;" vertex="1" parent="m1"><mxGeometry x="50" y="765" width="600" height="25" as="geometry"/></mxCell>

        <mxCell id="m-exec" value="SM 执行流水线&#xa;ALU / Tensor Core / LD-ST&#xa;warp 指令在 active lanes 上执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="55" y="180" width="225" height="110" as="geometry"/></mxCell>
        <mxCell id="m-reg" value="Register File&#xa;作用域：每 thread 私有&#xa;物理：SM 片上&#xa;最快、带宽最高；容量最小&#xa;保存 operands / accumulator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="335" y="165" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="m-smem" value="Shared Memory + L1&#xa;Shared：每 block 可见&#xa;L1：每 SM 的硬件缓存&#xa;物理：SM 片上、低延迟&#xa;tile 复用；注意 bank conflicts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;fontColor=#78350F;" vertex="1" parent="m1"><mxGeometry x="620" y="165" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="m-l2" value="L2 Cache&#xa;作用域：整个 GPU 共享&#xa;连接所有 SM 与 Memory Controllers&#xa;缓存 Global / Local 等流量&#xa;容量/延迟介于片上 SM 与显存之间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;fontColor=#78350F;" vertex="1" parent="m1"><mxGeometry x="925" y="165" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="m-dram" value="HBM / GDDR&#xa;CUDA Global Memory 的主要后备存储&#xa;所有 threads / kernels 可访问&#xa;容量最大、原始延迟高&#xa;靠高带宽 + 大量并发维持吞吐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;fontColor=#9F1239;" vertex="1" parent="m1"><mxGeometry x="1230" y="165" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="m-host" value="Host Memory&#xa;Pageable / Pinned / Unified Memory 后备页&#xa;经 PCIe / NVLink / CXL 类互连访问或迁移&#xa;通常比设备显存更远；Pinned 利于 DMA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#581C87;" vertex="1" parent="m1"><mxGeometry x="1230" y="535" width="280" height="125" as="geometry"/></mxCell>

        <mxCell id="m-const" value="Constant Memory 地址空间&#xa;设备只读、host 写入&#xa;经 constant cache 服务&#xa;同一 warp 读取同一地址时广播高效&#xa;不同地址会序列化/分多次服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontColor=#164E63;" vertex="1" parent="m1"><mxGeometry x="55" y="370" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="m-texture" value="Texture / Read-only 路径&#xa;只读数据的专用缓存/采样语义&#xa;适合具有空间局部性的读取&#xa;是否使用及具体缓存结构随架构/编译变化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontColor=#164E63;" vertex="1" parent="m1"><mxGeometry x="55" y="530" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="m-local" value="Local Memory 地址空间（重点）&#xa;语义：每 thread 私有&#xa;物理：通常位于设备内存，经 L1/L2 缓存&#xa;来源：register spill、动态索引数组、大对象&#xa;名字叫 local，不代表 SM 片上低延迟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontFamily=JetBrains Mono;fontSize=11;fontStyle=1;fontColor=#9F1239;" vertex="1" parent="m1"><mxGeometry x="335" y="545" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="m-global" value="Global Memory 地址空间&#xa;所有 threads 可寻址，通常由 cudaMalloc / 框架 allocator 分配&#xa;物理路径：L1（策略相关）→ L2 → HBM/GDDR&#xa;warp 连续地址应合并为尽量少的内存事务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#78350F;" vertex="1" parent="m1"><mxGeometry x="745" y="545" width="390" height="125" as="geometry"/></mxCell>

        <mxCell id="ml01" value="每条指令读写" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="m1"><mxGeometry x="286" y="220" width="43" height="30" as="geometry"/></mxCell>
        <mxCell id="ml02" value="显式 tile / cache" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="m1"><mxGeometry x="573" y="220" width="40" height="30" as="geometry"/></mxCell>
        <mxCell id="ml03" value="cache miss" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="m1"><mxGeometry x="879" y="220" width="38" height="30" as="geometry"/></mxCell>
        <mxCell id="ml04" value="Memory Controllers" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="m1"><mxGeometry x="1183" y="215" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="ml05" value="PCIe / NVLink" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;spacing=3;fontFamily=JetBrains Mono;fontSize=9;" vertex="1" parent="m1"><mxGeometry x="1350" y="405" width="70" height="28" as="geometry"/></mxCell>
        <mxCell id="ml06" value="register spill" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#FDA4AF;spacing=3;fontFamily=JetBrains Mono;fontSize=9;fontColor=#BE123C;" vertex="1" parent="m1"><mxGeometry x="430" y="510" width="82" height="28" as="geometry"/></mxCell>
        <mxCell id="ml07" value="经 L1 / L2" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#FDA4AF;spacing=3;fontFamily=JetBrains Mono;fontSize=9;fontColor=#BE123C;" vertex="1" parent="m1"><mxGeometry x="798" y="505" width="82" height="28" as="geometry"/></mxCell>

        <mxCell id="mr1" value="1. Registers 留住热数据&#xa;累加器和短生命周期标量尽量不落地&#xa;但 register 过多会降低 occupancy；spill 更昂贵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="55" y="815" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="mr2" value="2. Shared Memory 做 tile 复用&#xa;一次从 Global 搬入，block 内多次使用&#xa;合理 padding / layout 避免 bank conflicts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="375" y="815" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="mr3" value="3. Global 访问要 coalesced&#xa;一个 warp 的相邻 lanes 访问连续、对齐地址&#xa;减少内存事务数与无效传输字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="700" y="815" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="mr4" value="4. 提高 L2 locality / 减少中间落地&#xa;算子融合、合适的 block 排序与数据布局&#xa;让生产者—消费者少往返 HBM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="1025" y="815" width="285" height="110" as="geometry"/></mxCell>
        <mxCell id="mr5" value="5. 搬运与计算重叠&#xa;异步 copy / pipeline / 多 stages&#xa;前提是依赖、同步和资源占用允许" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#0891B2;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontStyle=1;" vertex="1" parent="m1"><mxGeometry x="1350" y="815" width="180" height="110" as="geometry"/></mxCell>

        <mxCell id="mlegend" value="定性层级（不是固定周期数）&#xa;延迟：Register &lt; Shared/L1 &lt; L2 &lt; HBM/GDDR &lt; Host&#xa;容量：方向相反&#xa;&#xa;具体容量、缓存合并方式和访问延迟随 GPU 架构、数据类型、命中率及访问模式变化。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=11;fontColor=#78350F;align=left;spacingLeft=12;" vertex="1" parent="m1"><mxGeometry x="55" y="1010" width="930" height="80" as="geometry"/></mxCell>
        <mxCell id="mwarning" value="三个常见误区&#xa;• Local Memory 不是片上“本地缓存”&#xa;• Shared Memory 与 L1 的具体组织随架构变化&#xa;• Occupancy 高不等于一定快：还要看带宽、延迟、ILP、bank conflict 和分支发散" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;fontFamily=JetBrains Mono;fontSize=10;fontColor=#9F1239;align=left;spacingLeft=10;" vertex="1" parent="m1"><mxGeometry x="1030" y="995" width="500" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
